DB_HOST=localhost
DB_PORT=5432
DB_NAME=airspace_tracker
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Необязательно: при отсутствии пары ключей OpenSky используется анонимный доступ
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Замените адрес на собственный действительный email, чтобы обеспечить контактность User-Agent
NOMINATIM_USER_AGENT=AircraftStudyCoursework/1.0 (contact: your-email@example.com)
